// general ref


Ref: TypedAttributeValue.entity_id > Entity.entity_id
Ref: TypedAttributeValue.attribute_id > Attribute.attribute_id

Ref: WasGeneratedBy.entity_id > Entity.entity_id
Ref: WasGeneratedBy.activity_id > Activity.activity_id

Ref: Used.entity_id > Entity.entity_id
Ref: Used.activity_id > Activity.activity_id

Ref: WasDerivedBy.entity_a_id > Entity.entity_id
Ref: WasDerivedBy.entity_b_id > Entity.entity_id

Ref: WasInformedBy.activity_a_id > Activity.activity_id
Ref: WasInformedBy.activity_b_id > Activity.activity_id

Ref: ActededOnBehalfOf.agent_a_id > Agent.agent_id
Ref: ActededOnBehalfOf.agent_b_id > Agent.agent_id


Ref: WasAttributedTo.entity_id > Entity.entity_id
Ref: WasAttributedTo.agent_id > Agent.agent_id

Ref: WasAssociatedWith.activity_id > Activity.activity_id
Ref: WasAssociatedWith.agent_id > Agent.agent_id
