// Use DBML to define your database structure
// Docs: https://dbml.dbdiagram.io/docs

Table Activity [headercolor: #3498DB] {
  activity_id uuid [primary key]
  activity_protocol_id uuid
  activity str
  started_at timestamp
  ended_at timestamp
}

// 
Table Entity [headercolor: #3498DB] {
  entity_id uuid [primary key]
}

Table Agent [headercolor: #3498DB] {
  agent_id uuid [primary key]
}

// M:N links
Table WasDerivedBy {
  entity_a_id uuid [primary key]
  entity_b_id uuid [primary key]
}

Table Used {
  entity_id uuid [primary key]
  activity_id uuid [primary key]
}

Table WasGeneratedBy {
  entity_id uuid [primary key]
  activity_id uuid [primary key]
}

Table WasAssociatedWith {
  activity_id uuid [primary key]
  agent_id uuid [primary key]
}

Table WasAttributedTo {
  agent_id uuid [primary key]
  entity_id uuid [primary key]
}

Table ActededOnBehalfOf {
  agent_a_id uuid [primary key]
  agent_b_id uuid [primary key]

  Note: '''
  '''
}

Table WasInformedBy {
  activity_a_id uuid [primary key]
  activity_b_id uuid [primary key]

  Note: '''
    Communication is the exchange of an entity by two activities, 
    one activity using the entity generated by the other.
  '''
}

// EAV

Table Attribute {
  attribute_id uuid [primary key]
  key string
}

Table TypedAttributeValue {
  entity_id uuid [primary key]
  attribute_id uuid [primary key]
  value string

  Note: '''
  '''
}

// Products
Table ProductPH {
  entity_id uuid [primary key]
  ph numeric
}
Ref: ProductPH.entity_id - Entity.entity_id

Table Sample {
  entity_id uuid [primary key]
}
Ref: Sample.entity_id - Entity.entity_id

Table ProcessedSample {
  entity_id uuid [primary key]
}
Ref: ProcessedSample.entity_id - Entity.entity_id

Table InstrumentData {
  entity_id uuid [primary key]
}
Ref: InstrumentData.entity_id - Entity.entity_id

Table ProcessedData {
  entity_id uuid [primary key]
}
Ref: ProcessedData.entity_id - Entity.entity_id



