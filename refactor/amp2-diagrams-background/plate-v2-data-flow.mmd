%%{ init: { 'theme': 'base', 'themeVariables': { 'fontSize': '13px' } } }%%
graph LR

%% =====================================================================
%% SIMPLIFIED: just the data flow, not the class hierarchy
%% Show what HAPPENS, not what IS_A what
%% =====================================================================

subgraph AMP2_ONLY [" AMP2   upstream culture chain "]
  direction TB
  MC["MediaCreation"]:::amp2 -->|creates| M["Media entity\n(reusable recipe)"]:::entity
  S["Strain entity\n(reference data)"]:::entity

  US["User Sample"]:::existing -->|"StrainPurity\n(QC gate)"| US2["✓"]:::amp2
  US -->|"StockCulturePrep"| SC["Stock Culture\n(processedSample)"]:::existing
  SC -->|"PreCultureGrowth"| PC["Pre-Culture\n(processedSample)"]:::existing
  PC -->|"ExperimentalCulture"| EC["Exp. Culture\n(processedSample)"]:::existing

  M -.->|"media_ref on\neach activity"| SC
  M -.->|"media_ref"| PC
  M -.->|"media_ref"| EC
  S -.->|"strain_ref"| SC
end

subgraph SHARED [" Shared: Plate Setup → Read → Product "]
  direction TB

  EC -->|input| A2S["AMP2\nPlateSetup"]:::amp2
  M -.->|media_ref| A2S
  A2S -->|output| A2P["AMP2 Plate\n(processedSample)"]:::existing

  SE["Soil Extract\n(processedSample)"]:::existing -->|input| EPS["Ecoplate\nPlateSetup"]:::ecoplate
  EPS -->|output| EPP["Ecoplate Plate\n(processedSample)"]:::existing

  A2P -->|"analyte_id"| A2R["AMP2\nAnalysis\nt=0, t=24h..."]:::amp2
  EPP -->|"analyte_id"| EPR["Ecoplate\nAnalysis\nt=0, t=24h..."]:::ecoplate

  A2R -->|produces| A2D["AMP2ODProduct\nwell_readings: JSON"]:::amp2
  EPR -->|produces| EPD["EcoplateAbsProduct\nwell_readings: JSON"]:::ecoplate
end

%% =====================================================================
%% STYLES
%% =====================================================================
classDef amp2 fill:#5CB85C,stroke:#3D8B3D,color:#fff,stroke-width:2px
classDef ecoplate fill:#F0AD4E,stroke:#C77C25,color:#fff,stroke-width:2px
classDef existing fill:#9B59B6,stroke:#6C3483,color:#fff,stroke-width:2px
classDef entity fill:#4A90D9,stroke:#2C5F8A,color:#fff,stroke-width:2px
