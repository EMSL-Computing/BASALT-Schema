%%{ init: { 'theme': 'base', 'themeVariables': { 'fontSize': '14px' } } }%%
graph TD

%% =====================================================================
%% COLOR LEGEND
%% Blue    = NEW abstract/shared classes
%% Green   = AMP2-specific path
%% Orange  = Ecoplate-specific path
%% Purple  = Existing schema (unchanged)
%% Gray    = Mixin (cross-cutting)
%% =====================================================================

subgraph legend [" Legend "]
  direction LR
  L1[" 🔵 New Abstract / Shared "]:::abstract
  L2[" 🟢 AMP2-specific "]:::amp2
  L3[" 🟠 Ecoplate-specific "]:::ecoplate
  L4[" 🟣 Existing schema "]:::existing
  L5[" ⬜ Mixin "]:::mixin
end

%% =====================================================================
%% NEW ENTITY LAYER (labEntity hierarchy)
%% =====================================================================
subgraph entities [" §C  Lab Entities   NEW non-sample things "]
  direction LR
  labEntity["labEntity\n(abstract)"]:::abstract
  Media["Media\nmedia_type, recipe,\nformulation, pH, ..."]:::abstract
  Strain["Strain\nstrain_id, type,\nsource, mutation"]:::abstract

  labEntity -.->|is_a| Media
  labEntity -.->|is_a| Strain
end

%% =====================================================================
%% LAB PREPARATION ACTIVITY (creates entities, NOT samples)
%% =====================================================================
subgraph entity_activities [" §D  Entity Creation   NOT sampleProcessing "]
  labPrepAct["labPreparationActivity\n(abstract)"]:::abstract
  MediaCreation["MediaCreation\ncreation_date"]:::abstract

  labPrepAct -.->|is_a| MediaCreation
end

MediaCreation -->|"produces\n(media_output_id FK)"| Media

%% =====================================================================
%% MIXINS (cross-cutting concerns)
%% =====================================================================
subgraph mixins [" §A  Mixins   shared slot bundles "]
  direction LR
  HasIncubation["HasIncubationConditions\ntemp °C, RPM, O₂"]:::mixin
  UsesMedia["UsesMedia\nmedia_ref → Media"]:::mixin
  UsesStrain["UsesStrain\nstrain_ref → Strain"]:::mixin
end

%% =====================================================================
%% CULTURE GROWTH ACTIVITIES (sampleProcessing subclasses)
%% =====================================================================
subgraph culture [" §E  Culture Growth Chain   is_a sampleProcessing "]
  CultureGrowth["CultureGrowth\n(abstract)\nincubation_time, container"]:::amp2
  StrainPurity["StrainPurity\ninspection_method"]:::amp2
  StockCulturePrep["StockCulturePreparation\npreparation_date"]:::amp2
  PreCultureGrowth["PreCultureGrowth"]:::amp2
  ExperimentalCulture["ExperimentalCulture\ntreatment_type, growth_time"]:::amp2

  CultureGrowth -.->|is_a| StrainPurity
  CultureGrowth -.->|is_a| StockCulturePrep
  CultureGrowth -.->|is_a| PreCultureGrowth
  CultureGrowth -.->|is_a| ExperimentalCulture
end

%% Mixin connections to CultureGrowth
HasIncubation ====>|mixin| CultureGrowth
UsesMedia ====>|mixin| CultureGrowth
UsesStrain ====>|mixin| CultureGrowth

%% =====================================================================
%% SAMPLE FLOW (existing processedSample types)
%% =====================================================================
subgraph samples [" Samples   existing schema, new enum values "]
  UserSample["sample\n(user_sample)"]:::existing
  StockCulture["processedSample\n(stock_culture)"]:::existing
  PreCulture["processedSample\n(pre_culture)"]:::existing
  ExpCulture["processedSample\n(experimental_culture)"]:::existing
  SoilExtract["processedSample\n(soil_extract)"]:::existing
  AMP2Plate["processedSample\n(amp2_96well_plate)"]:::existing
  EcoPlate["processedSample\n(ecoplate_plate)"]:::existing
end

%% Culture chain flow (AMP2 path)
UserSample -->|"processingSampleLink"| StrainPurity
UserSample -->|"processingSampleLink"| StockCulturePrep
StockCulturePrep -->|output| StockCulture
StockCulture -->|input| PreCultureGrowth
PreCultureGrowth -->|output| PreCulture
PreCulture -->|input| ExperimentalCulture
ExperimentalCulture -->|output| ExpCulture

%% Entity references on culture activities
Media -.->|"media_ref"| StrainPurity
Media -.->|"media_ref"| StockCulturePrep
Media -.->|"media_ref"| PreCultureGrowth
Media -.->|"media_ref"| ExperimentalCulture
Strain -.->|"strain_ref"| StrainPurity
Strain -.->|"strain_ref"| StockCulturePrep

%% =====================================================================
%% PLATE SETUP (sampleProcessing subclasses   BRANCHED)
%% =====================================================================
subgraph plate_setup [" §F  Plate Setup   is_a sampleProcessing "]
  PlateSetupAct["PlateSetupActivity\n(abstract)\nplate_type, barcode,\nsetup_date, well_metadata[]"]:::abstract
  AMP2Setup["AMP2PlateSetupActivity\n+ UsesMedia mixin"]:::amp2
  EcoplateSetup["EcoplatePlateSetupActivity\nNO media   per-well design"]:::ecoplate

  PlateSetupAct -.->|is_a| AMP2Setup
  PlateSetupAct -.->|is_a| EcoplateSetup
end

HasIncubation ====>|mixin| PlateSetupAct
UsesMedia ====>|mixin| AMP2Setup

%% Flow into plate setup
ExpCulture -->|input| AMP2Setup
SoilExtract -->|input| EcoplateSetup
AMP2Setup -->|output| AMP2Plate
EcoplateSetup -->|output| EcoPlate
Media -.->|"media_ref"| AMP2Setup

%% =====================================================================
%% PLATE ANALYSIS (analysisActivity subclasses)
%% =====================================================================
subgraph plate_analysis [" §G  Plate Measurement   is_a analysisActivity "]
  PlateAnalysis["PlateAnalysisActivity\n(abstract)\ntimepoint_label"]:::abstract
  AMP2Analysis["AMP2AnalysisActivity\nmeasurement_type,\nwavelength_nm"]:::amp2
  EcoplateAnalysis["EcoplateAnalysisActivity\nwavelength_nm=590"]:::ecoplate

  PlateAnalysis -.->|is_a| AMP2Analysis
  PlateAnalysis -.->|is_a| EcoplateAnalysis
end

AMP2Plate -->|"analyte_id"| AMP2Analysis
EcoPlate -->|"analyte_id"| EcoplateAnalysis

%% =====================================================================
%% PRODUCTS (satellite tables off processedData)
%% =====================================================================
subgraph products [" §H  Products   satellite tables "]
  PlateProduct["PlateProduct\n(abstract)\nwavelength, timepoint,\nplate_avg, well_readings[]"]:::abstract
  AMP2OD["AMP2ODProduct\nplate_reader_model"]:::amp2
  EcoAbs["EcoplateAbsorbanceProduct\nplate_lot, AWCD,\nuninoculated_mean"]:::ecoplate

  PlateProduct -.->|is_a| AMP2OD
  PlateProduct -.->|is_a| EcoAbs
end

AMP2Analysis -->|"→ WEA →"| AMP2OD
EcoplateAnalysis -->|"→ WEA →"| EcoAbs

%% =====================================================================
%% EMBEDDED VALUE OBJECTS
%% =====================================================================
subgraph embedded [" §I  Embedded JSONB   NOT tables "]
  direction LR
  WellMeta["WellMetadata\nposition, well_type,\nreplicate_group"]:::abstract
  AMP2Well["AMP2WellMetadata\nmedia_vol, inoc_vol,\nsample_id, treatments"]:::amp2
  EcoWell["EcoplateWellMetadata\nmedia_vol, carbon_source,\ntreatment, concentration"]:::ecoplate
  WellRead["WellReading\nposition, value, flag"]:::abstract

  WellMeta -.->|is_a| AMP2Well
  WellMeta -.->|is_a| EcoWell
end

PlateSetupAct -.->|"well_metadata[]"| WellMeta
PlateProduct -.->|"well_readings[]"| WellRead

%% =====================================================================
%% STYLES
%% =====================================================================
classDef abstract fill:#4A90D9,stroke:#2C5F8A,color:#fff,stroke-width:2px
classDef amp2 fill:#5CB85C,stroke:#3D8B3D,color:#fff,stroke-width:2px
classDef ecoplate fill:#F0AD4E,stroke:#C77C25,color:#fff,stroke-width:2px
classDef existing fill:#9B59B6,stroke:#6C3483,color:#fff,stroke-width:2px
classDef mixin fill:#BDC3C7,stroke:#7F8C8D,color:#2C3E50,stroke-width:2px,stroke-dasharray: 5 5
