kubectl get services -n analysis-api-dev

kubectl apply -f k8s/flask-db-migration-job.yaml
kubectl get jobs -n analysis-api-dev
kubectl logs job/flask-db-migration -n analysis-api-dev

kubectl delete job flask-db-migration -n analysis-api-dev



kubectl exec -it deployment/web -n analysis-api-dev -- flask db history --verbose

get pods -n analysis-api-dev
kubectl port-forward web-postgresql-0 -n analysis-api-dev 5432:5435
